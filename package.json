{
	"name": "cut-branches",
	"version": "0.5.0",
	"scripts": {
		"dev:svelte": "vite dev",
		"build:svelte": "vite build",
		"dev": "tauri dev",
		"build": "tauri build",
		"build:debug": "RUST_BACKTRACE=1 tauri build --debug",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:fix": "prettier --write .",
		"format": "prettier --check .",
		"check": "svelte-check",
		"deps:check": "depcruise --config .dependency-cruiser.cjs src",
		"tauri": "tauri",
		"update-all": "pnpm update -irL && cd src-tauri && cargo update && cd ..",
		"changeset": "changeset",
		"prepare": "svelte-kit sync && panda codegen && lefthook install",
		"version-packages": "changeset version && pnpm update-tauri-version",
		"test": "HEADLESS=true vitest --run --coverage",
		"test:watch": "vitest --watch --coverage",
		"test:ui": "vitest --coverage --ui",
		"test:ui:headless": "HEADLESS=true vitest --coverage --ui",
		"test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:cargo:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml",
		"test:cargo:coverage:html": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html",
		"test:cargo:coverage:open": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html && open src-tauri/target/llvm-cov/html/index.html",
		"test:cargo:coverage:text": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --text",
		"test:cargo:coverage:lcov": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lcov --output-path src-tauri/lcov.info",
		"release": "changeset git-tag",
		"clean": "rm -rf dist && rm -rf node_modules",
		"update-tauri-version": "node scripts/update-tauri-version.mjs",
		"rust:fmt": "cd src-tauri && cargo fmt --all -- --check",
		"rust:fmt:fix": "cd src-tauri && cargo fmt --all",
		"rust:clippy": "cd src-tauri && cargo clippy -- -D warnings",
		"rust:test": "cd src-tauri && cargo test --all-features",
		"rust:check": "pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test"
	},
	"devDependencies": {
		"@changesets/changelog-github": "1.0.1",
		"@changesets/cli": "^3.0.2",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@iconify/svelte": "^5.2.2",
		"@pandacss/dev": "^1.12.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tanstack/svelte-query-devtools": "^6.1.48",
		"@tauri-apps/cli": "^2.11.4",
		"@types/ramda": "^0.32.0",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"@vitest/coverage-istanbul": "^5.0.0",
		"@vitest/coverage-v8": "^5.0.0",
		"@vitest/ui": "^5.0.0",
		"dependency-cruiser": "^18.2.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^3.23.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.12.0",
		"lefthook": "^2.1.12",
		"prettier": "~3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"dependencies": {
		"@pindoba/core-menu": "alpha",
		"@pindoba/core-tree-view": "alpha",
		"@pindoba/devtools": "alpha",
		"@pindoba/panda": "alpha",
		"@pindoba/panda-buildinfo": "alpha",
		"@pindoba/panda-preset": "alpha",
		"@pindoba/svelte-accordion": "alpha",
		"@pindoba/svelte-alert": "alpha",
		"@pindoba/svelte-attachment": "alpha",
		"@pindoba/svelte-badge": "alpha",
		"@pindoba/svelte-banner": "alpha",
		"@pindoba/svelte-breadcrumb": "alpha",
		"@pindoba/svelte-button": "alpha",
		"@pindoba/svelte-card": "alpha",
		"@pindoba/svelte-checkbox": "alpha",
		"@pindoba/svelte-choice": "alpha",
		"@pindoba/svelte-dialog": "alpha",
		"@pindoba/svelte-group": "alpha",
		"@pindoba/svelte-input": "alpha",
		"@pindoba/svelte-loading": "alpha",
		"@pindoba/svelte-menu": "alpha",
		"@pindoba/svelte-navigation": "alpha",
		"@pindoba/svelte-pagination": "alpha",
		"@pindoba/svelte-panel": "alpha",
		"@pindoba/svelte-popover": "alpha",
		"@pindoba/svelte-progress": "alpha",
		"@pindoba/svelte-radio": "alpha",
		"@pindoba/svelte-stamp": "alpha",
		"@pindoba/svelte-theme-mode-select": "alpha",
		"@pindoba/svelte-toast": "alpha",
		"@pindoba/svelte-tooltip": "alpha",
		"@pindoba/svelte-tree-view": "alpha",
		"@tanstack/svelte-query": "^6.1.48",
		"@tanstack/svelte-virtual": "^3.13.36",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "~2.7.3",
		"@tauri-apps/plugin-log": "^2.9.1",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"@tauri-apps/plugin-os": "^2.3.2",
		"@vitest/browser-playwright": "^5.0.0",
		"date-fns": "^4.4.0",
		"date-fns-tz": "^3.2.0",
		"just-debounce-it": "^3.2.0",
		"ramda": "^0.32.0",
		"shiki": "^4.4.3",
		"svelte-exmarkdown": "^5.0.2",
		"vitest-browser-svelte": "^3.1.0",
		"zod": "^4.5.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": []
	},
	"packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
