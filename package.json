{
	"name": "cut-branches",
	"version": "0.5.0",
	"scripts": {
		"dev:svelte": "vite dev",
		"build:svelte": "vite build",
		"dev": "tauri dev",
		"build": "tauri build",
		"build:debug": "RUST_BACKTRACE=1 tauri build --debug",
		"preview": "vite preview",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:fix": "prettier --write .",
		"format": "prettier --check .",
		"check": "svelte-check",
		"tauri": "tauri",
		"update-all": "pnpm update -irL && cd src-tauri && cargo update && cd ..",
		"changeset": "changeset",
		"prepare": "bash scripts/pindoba-link-wrapper.sh && svelte-kit sync && panda codegen && lefthook install",
		"version-packages": "git push && changeset version && pnpm update-tauri-version",
		"test": "vitest --run --coverage",
		"test:watch": "vitest --watch --coverage",
		"test:ui": "vitest --coverage --ui",
		"test:cargo": "cargo test --manifest-path src-tauri/Cargo.toml",
		"test:cargo:coverage": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml",
		"test:cargo:coverage:html": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html",
		"test:cargo:coverage:open": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --html && open src-tauri/target/llvm-cov/html/index.html",
		"test:cargo:coverage:text": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --text",
		"test:cargo:coverage:lcov": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lcov --output-path src-tauri/lcov.info",
		"release": "changeset tag",
		"clean": "rm -rf dist && rm -rf node_modules",
		"update-tauri-version": "node scripts/update-tauri-version.mjs",
		"pindoba:link": "bash scripts/manage-pindoba-links.sh link",
		"pindoba:unlink": "bash scripts/manage-pindoba-links.sh unlink",
		"pindoba:status": "bash scripts/manage-pindoba-links.sh status",
		"pindoba:clean": "bash scripts/manage-pindoba-links.sh clean",
		"rust:fmt": "cd src-tauri && cargo fmt --all -- --check",
		"rust:fmt:fix": "cd src-tauri && cargo fmt --all",
		"rust:clippy": "cd src-tauri && cargo clippy -- -D warnings",
		"rust:test": "cd src-tauri && cargo test --all-features",
		"rust:check": "pnpm rust:fmt && pnpm rust:clippy && pnpm rust:test"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/js": "^9.39.1",
		"@iconify/svelte": "^5.1.0",
		"@pandacss/dev": "^1.4.3",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.48.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tanstack/svelte-query-devtools": "^6.0.0",
		"@tauri-apps/cli": "^2.9.2",
		"@types/ramda": "^0.31.1",
		"@typescript-eslint/eslint-plugin": "^8.46.3",
		"@typescript-eslint/parser": "^8.46.3",
		"@vitest/coverage-istanbul": "^4.0.7",
		"@vitest/coverage-v8": "^4.0.7",
		"@vitest/ui": "^4.0.7",
		"csstype": "^3.1.3",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^3.13.0",
		"eslint-plugin-unused-imports": "^4.3.0",
		"globals": "^16.5.0",
		"i": "^0.3.7",
		"lefthook": "^2.0.2",
		"prettier": "~3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "5.43.3",
		"svelte-check": "^4.3.3",
		"svelte-preprocess": "^6.0.3",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.3",
		"vite": "^7.1.12",
		"vitest": "^4.0.7"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/fira-mono": "^5.2.7",
		"@pindoba/panda": "alpha",
		"@pindoba/panda-buildinfo": "link:../pindoba/packages/panda-buildinfo",
		"@pindoba/panda-preset": "link:../pindoba/packages/panda-preset",
		"@pindoba/svelte-alert": "link:../pindoba/packages/ui/svelte/alert",
		"@pindoba/svelte-badge": "link:../pindoba/packages/ui/svelte/badge",
		"@pindoba/svelte-button": "link:../pindoba/packages/ui/svelte/button",
		"@pindoba/svelte-checkbox": "link:../pindoba/packages/ui/svelte/checkbox",
		"@pindoba/svelte-dialog": "link:../pindoba/packages/ui/svelte/dialog",
		"@pindoba/svelte-group": "link:../pindoba/packages/ui/svelte/group",
		"@pindoba/svelte-loading": "link:../pindoba/packages/ui/svelte/loading",
		"@pindoba/svelte-navigation": "link:../pindoba/packages/ui/svelte/navigation",
		"@pindoba/svelte-pagination": "link:../pindoba/packages/blocks/svelte/pagination",
		"@pindoba/svelte-popover": "link:../pindoba/packages/ui/svelte/popover",
		"@pindoba/svelte-radio": "link:../pindoba/packages/ui/svelte/radio",
		"@pindoba/svelte-select": "link:../pindoba/packages/ui/svelte/select",
		"@pindoba/svelte-text-input": "link:../pindoba/packages/ui/svelte/text-input",
		"@pindoba/svelte-theme-mode-select": "link:../pindoba/packages/blocks/svelte/theme-mode-select",
		"@radix-ui/colors": "^3.0.0",
		"@tanstack/svelte-query": "^6.0.4",
		"@tauri-apps/api": "^2.9.0",
		"@tauri-apps/plugin-dialog": "~2.4.2",
		"@tauri-apps/plugin-shell": "~2.3.3",
		"@types/lodash": "^4.17.20",
		"@vitest/browser-playwright": "^4.0.7",
		"date-fns": "^4.1.0",
		"date-fns-tz": "^3.2.0",
		"hash-it": "^6.0.0",
		"just-debounce-it": "^3.2.0",
		"lodash": "^4.17.21",
		"ramda": "^0.32.0",
		"svelte-exmarkdown": "^5.0.2",
		"vitest-browser-svelte": "^2.0.1",
		"zod": "^4.1.12"
	},
	"pnpm": {
		"patchedDependencies": {
			"@changesets/changelog-github@0.5.1": "patches/@changesets__changelog-github@0.5.1.patch"
		},
		"onlyBuiltDependencies": [
			"svelte-preprocess"
		]
	},
	"packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd"
}
