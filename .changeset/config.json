{
	"$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
	"changelog": [
		"@changesets/changelog-github",
		{
			"repo": "eduardolopes/cut-branches",
			"template": "\n\n- {pull} {commit} - {summary} (Thanks {authors})"
		}
	],
	"commit": false,
	"fixed": [],
	"linked": [],
	"access": "restricted",
	"baseBranch": "main",
	"updateInternalDependencies": "patch",
	"ignore": []
}
