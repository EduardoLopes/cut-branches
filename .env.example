# ===================================
# Cut Branches - Environment Configuration
# ===================================

# ---------------------------------
# Pindoba Local Development
# ---------------------------------
# Controls whether to use local Pindoba packages or published versions from npm
#
# Set to 'true' to link local Pindoba packages from ../pindoba directory
# Set to 'false' or remove this line to use published packages
#
# Requirements for local linking:
# - Pindoba repository must be cloned to ../pindoba (relative to this project)
# - Run 'pnpm install' after changing this setting
#
# Usage:
#   true  - Use local packages (for Pindoba development)
#   false - Use published packages (default, for production)
#
USE_LOCAL_PINDOBA=false
