# ===================================
# Cut Branches - Environment Configuration
# ===================================

# ---------------------------------
# Pindoba Local Development
# ---------------------------------
# Controls whether Vite resolves @pindoba/svelte-* packages from a local
# checkout of the Pindoba monorepo or from the published packages on npm.
#
# When set to 'true':
#   - Vite aliases each @pindoba/svelte-* import to ../pindoba/packages/<pkg>/dist
#   - svelte-check / TypeScript resolve types from those same dist folders
#   - No 'pnpm install' is needed when toggling this value — just restart the dev server
#
# Requirements for local mode:
#   - Pindoba repository cloned to ../pindoba (sibling of this project)
#   - Each consumed package built (dist/ populated). For HMR while editing
#     Pindoba sources, run the package's watcher in ../pindoba, e.g.:
#       pnpm --filter @pindoba/svelte-button dev
#
# Usage:
#   true  - Use local Pindoba dist folders via Vite aliases
#   false - Use published packages from npm (default)
#
USE_LOCAL_PINDOBA=false
